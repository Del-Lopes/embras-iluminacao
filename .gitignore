# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/supabase

# tests
/tests
/test-results

# docs — nenhum markdown sobe, menos o README. Substitui a lista que havia
# aqui arquivo a arquivo, que exigia lembrar de incluir cada novo.
*.md
!README.md
/white-label

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude / serena internal
.serena/

# typescript
*.tsbuildinfo
next-env.d.ts
/scripts/

# backups
*.backup.tsx

# ferramentas locais — cache do plugin impeccable (revisão de design),
# gerado por máquina e sem valor para o repositório
/.impeccable

# Componentes sem uso. Ficam no disco, porque guardam coreografias que podem
# voltar, mas não sobem: no repositório eles só somariam código morto para o
# próximo leitor decidir se pode mexer.
/src/components/catalog/ProductSpecs.tsx
/src/components/common/CascadeText.tsx
/src/components/common/FadeIn.tsx
/src/components/common/FragmentedReveal.tsx
/src/components/common/ImageGallery.tsx
/src/components/common/VaporizeTextCycle.tsx
/src/lib/ai/article-searcher.ts
/src/sections/ContactSection.tsx
/src/sections/HeroProductsWrapper.backup.tsx
/src/sections/HeroProductsWrapper.tsx
/src/sections/ProductCarousel.tsx
/src/sections/ProductLineCard.tsx
/src/sections/TestimonialsSection.tsx

# ferramentas locais — skills de auditoria instaladas na máquina, não fazem
